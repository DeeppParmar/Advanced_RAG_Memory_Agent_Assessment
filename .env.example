# API Keys
OPENAI_API_KEY=your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Vector Database (Qdrant)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=advanced_rag_documents

# Retrieval & Compression Configuration
CHILD_CHUNK_SIZE=200
PARENT_CHUNK_SIZE=1000
CHUNK_OVERLAP=50
HYBRID_TOP_K=20
RERANK_TOP_N=5
RERANK_SCORE_THRESHOLD=0.3
RRF_K=60
COHERE_RERANK_MODEL=rerank-english-v3.0

# Memory Storage Path
MEMORY_STORAGE_PATH=data/user_memories.json
